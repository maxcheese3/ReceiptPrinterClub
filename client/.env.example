# PrintBridge Client Configuration
# Copy this file to .env and fill in your values.

# URL of your PrintBridge server (no trailing slash)
SERVER_URL=http://localhost:3000

# Your printer's API key (given when you registered the printer)
API_KEY=your-api-key-here

# How often to poll for new messages (milliseconds). Default: 5000 (5 seconds)
POLL_INTERVAL_MS=5000

# Path to the SumatraPDF executable (for image/text printing on Windows).
# Download from https://www.sumatrapdfreader.org/
# If not set, the client will attempt to use the built-in Windows print command.
# SUMATRA_PATH=C:\Program Files\SumatraPDF\SumatraPDF.exe

# Temp directory for downloaded files before printing. Default: system temp.
# TEMP_DIR=C:\printbridge-temp

# Log level: debug | info | warn | error. Default: info
LOG_LEVEL=info
