# PrintBridge Client Configuration
# Copy this file to .env and fill in your values.

# URL of your PrintBridge server (no trailing slash)
SERVER_URL=http://localhost:3000

# Your printer's API key (given when you registered the printer)
API_KEY=your-api-key-here

# How often to poll for new messages (milliseconds). Default: 5000 (5 seconds)
POLL_INTERVAL_MS=5000

# Printer name override. Leave blank to use the Windows default printer.
# PRINTER_NAME=My Printer Name

# Font size for text printing (points). Default: 9
# Smaller = more columns fit, larger = easier to read.
PRINT_FONT_SIZE=9

# Number of characters that fit across the paper width at the chosen font size.
# Used by the web UI to enforce line-length limits.
# Measure by printing a test page and counting characters per line.
# Common values: 22 (58mm thermal), 32 (80mm thermal), 80 (A4/Letter)
PRINT_COLUMNS=24

# Temp directory for downloaded files before printing. Default: system temp.
# TEMP_DIR=C:\printbridge-temp

# Log level: debug | info | warn | error. Default: info
LOG_LEVEL=info

# Paper width in mm and printer DPI — used for image dithering on all platforms
# Match these to your printer for best image quality
PRINT_WIDTH_MM=58
PRINT_DPI=203

# ── Local archive ────────────────────────────────────────────────────────────────
# Save a local copy of every message and image received
# Set to "false" to disable
ARCHIVE_ENABLED=true

# Directory to save archive files (default: ./archive next to client.js)
# ARCHIVE_DIR=C:\printbridge-archive

# ── Linux / macOS printing ────────────────────────────────────────────────────

# Option A: Raw ESC/POS via USB device (RECOMMENDED for thermal printers)
# No CUPS or drivers needed.
#
# Linux: grant access with: sudo usermod -aG lp $USER  (then log out/in)
#   PRINTER_DEVICE=/dev/usb/lp0
#   Also try: /dev/lp0
#
# macOS: USB thermal printers appear as a serial device. Find yours with:
#   ls /dev/cu.usb*   or   ls /dev/tty.usb*
# Example values:
#   PRINTER_DEVICE=/dev/cu.usbserial-1410
#   PRINTER_DEVICE=/dev/cu.usbmodem14101
# Grant access (if permission denied): sudo chmod a+rw /dev/cu.usbserial-XXXX
#
PRINTER_DEVICE=/dev/usb/lp0

# Option B: CUPS (comment out PRINTER_DEVICE, install canvas: npm install canvas)
# List available printers with: lpstat -p  (works on both Linux and macOS)
# PRINTER_NAME=my-thermal-printer

# Paper width in mm (default: 58 for 58mm thermal roll)
PRINT_WIDTH_MM=58

# Printer DPI — used for image scaling in ESC/POS mode (default: 203)
# Common thermal DPIs: 203, 300, 600
PRINT_DPI=203
