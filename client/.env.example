# PrintBridge Client Configuration
# Copy this file to .env and fill in your values.
#
# Characters per line, emoji style, and the test page are on the website's
# My Printer page, not here. Font size is picked by whoever sends each message.

# URL of your PrintBridge server (no trailing slash)
SERVER_URL=http://localhost:3000

# Your printer's API key (given when you registered the printer)
API_KEY=your-api-key-here

# How often to poll for new messages (milliseconds). Default: 5000 (5 seconds)
POLL_INTERVAL_MS=5000

# Log level: debug | info | warn | error. Default: info
LOG_LEVEL=info

# Timezone for printed/archived timestamps (IANA name, e.g. America/Chicago,
# America/New_York, Europe/London). Required when running in Docker — the
# container has no access to the host's timezone otherwise and will print
# UTC times. Find your zone name at https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# TZ=America/Chicago

# ── Where the printer is ──────────────────────────────────────────────────────
# Set ONE of these. With neither, jobs go to the system's default printer.
#
# PRINTER_DEVICE — a device file, written to directly. Fastest and simplest.
#   Linux USB:        /dev/usb/lp0   (or /dev/lp0)
#                     grant access with: sudo usermod -aG lp $USER  (then log out/in)
#   Linux Bluetooth:  /dev/rfcomm0   (after pairing and `rfcomm bind`)
#   macOS USB/serial: /dev/cu.usbserial-XXXX  (find with: ls /dev/cu.*)
#                     if permission denied: sudo chmod a+rw /dev/cu.usbserial-XXXX
# PRINTER_DEVICE=/dev/usb/lp0
#
# PRINTER_NAME — a print queue by name. Use this for network/wifi printers or
# anything already set up in the OS.
#   macOS/Linux: the CUPS queue name, from `lpstat -p`
#   Windows:     the printer name shown in Settings > Printers
# PRINTER_NAME=My Thermal Printer

# ── How jobs are sent ─────────────────────────────────────────────────────────
# escpos (default): raw ESC/POS commands — identical output on every OS.
# driver: hand the receipt to the OS print driver instead. Only for printers
#   that ignore ESC/POS, such as the Star TSP100 series. Requires PRINTER_NAME
#   (or a default printer). Bold, underline and banners may not show.
# PRINT_MODE=escpos

# Driver mode on macOS/Linux only: CUPS media name. Defaults to the Star
# driver's long receipt size for your paper width (X72MMY2000MM for 80mm,
# X50D8MMY2000MM for 58mm).
# PRINT_CUPS_MEDIA=X72MMY2000MM

# ── Image tuning ──────────────────────────────────────────────────────────────
# Brightness lift before dithering, 0-255 (default: 40). Thermal paper prints
# darker than a screen — raise this if images print too dark, lower it if
# they're washed out.
PRINT_BRIGHTNESS=40

# Max raster lines per ESC/POS graphics command (default: 256). Lower this
# (e.g. 128) if very tall images print as garbled characters — some printers
# have a small buffer.
PRINT_RASTER_CHUNK_ROWS=256

# ── Local archive ─────────────────────────────────────────────────────────────
# Save a local copy of every message and image received. "false" to disable.
ARCHIVE_ENABLED=true

# Directory to save archive files (default: ./archive next to client.js)
# ARCHIVE_DIR=C:\printbridge-archive

# Temp directory for print jobs. Default: system temp.
# TEMP_DIR=C:\printbridge-temp
