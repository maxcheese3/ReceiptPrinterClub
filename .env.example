# PrintBridge Server Environment
# Copy this to .env and fill in your values.

# ── Public hosting ──────────────────────────────────────────────────────────────

# Option A: Caddy with a real domain
# Your domain name (must point to this machine's public IP via DNS A record)
# Caddy will automatically obtain a free TLS cert from Let's Encrypt.
DOMAIN=print.yourdomain.com

# Option B: Cloudflare Tunnel (no domain/port-forwarding needed)
# Uncomment cloudflared in docker-compose.yml and paste your tunnel token here.
# CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here

# ── Admin UI ────────────────────────────────────────────────────────────────────
# Password for the admin panel on the website
ADMIN_PASSWORD=changeme

# Optional: set a stable secret so admin tokens survive server restarts
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ADMIN_TOKEN_SECRET=your-hex-secret-here
